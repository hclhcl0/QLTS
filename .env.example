# Coolify Environment Variables Configuration
# Copy these to Coolify -> Environment Variables

PORT=3001
NODE_ENV=production
JWT_SECRET=qlts-cdc-danang-secret-key-2026

# PostgreSQL connection string from Coolify PostgreSQL service
DATABASE_URL=postgresql://postgres:your_password@postgres-host:5432/qlts?schema=public

# Persistent uploads path & CORS
UPLOADS_DIR=/app/server/uploads
CORS_ORIGIN=*
